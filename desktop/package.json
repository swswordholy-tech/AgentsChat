{
  "name": "@agentschat/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AgentsChat Desktop for macOS & Windows — Cloud workspace + embedded Local Mini-Server with globally unique AgentsChat identities.",
  "author": "AgentsChat",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "server:local": "npm run build && node out/cli-local-server.js",
    "test": "bun test ./tests/",
    "smoke:electron": "npm run build && node scripts/smoke-electron.mjs",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:mac": "npm run build && electron-builder --mac dmg zip",
    "pack:win": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.18.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.agentschat.desktop",
    "productName": "AgentsChat",
    "files": [
      "out/**/*",
      "ui/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
